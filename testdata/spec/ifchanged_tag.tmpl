=== consecutive duplicates suppressed ===
{% assign seq = "a,a,b,b,b,c,a,a" | split: "," -%}
{% for v in seq -%}
{% ifchanged %}{{ v }}{% endifchanged %}
{%- endfor %}

=== shared register across blocks (Shopify parity) ===
{% assign seq2 = "x,y,y,x" | split: "," -%}
{% for v in seq2 -%}
[{% ifchanged %}{{ v }}{% endifchanged %}|{% ifchanged %}{{ v }}{% endifchanged %}]
{% endfor -%}
