=== cols only ===
<tr class="row1">
<td class="col1">1</td><td class="col2">2</td><td class="col3">3</td></tr>
<tr class="row2"><td class="col1">4</td><td class="col2">5</td><td class="col3">6</td></tr>
<tr class="row3"><td class="col1">7</td><td class="col2">8</td><td class="col3">9</td></tr>
<tr class="row4"><td class="col1">10</td></tr>

=== limit ===
<tr class="row1">
<td class="col1">1</td><td class="col2">2</td></tr>
<tr class="row2"><td class="col1">3</td><td class="col2">4</td></tr>
<tr class="row3"><td class="col1">5</td></tr>

=== offset ===
<tr class="row1">
<td class="col1">8</td><td class="col2">9</td></tr>
<tr class="row2"><td class="col1">10</td></tr>

=== limit + offset ===
<tr class="row1">
<td class="col1">4</td><td class="col2">5</td></tr>
<tr class="row2"><td class="col1">6</td><td class="col2">7</td></tr>

=== empty collection ===
<tr class="row1">
</tr>

=== break inside ===
<tr class="row1">
<td class="col1">1</td><td class="col2">2</td></tr>
<tr class="row2"><td class="col1">3</td><td class="col2"></td></tr>

=== continue inside ===
<tr class="row1">
<td class="col1">1</td><td class="col2">2</td></tr>
<tr class="row2"><td class="col1"></td><td class="col2">4</td></tr>
<tr class="row3"><td class="col1">5</td><td class="col2">6</td></tr>
<tr class="row4"><td class="col1">7</td><td class="col2">8</td></tr>
<tr class="row5"><td class="col1">9</td><td class="col2">10</td></tr>

